# Normalize line endings now, while the repository is small — doing it later
# renormalizes the whole tree in one commit that reviews as noise.
* text=auto eol=lf

# Packagist's dist archive is `git archive`, so export-ignore decides what a
# project downloads. LICENSE stays: MIT requires the notice to accompany every
# copy, and an install is one.
/.gitattributes    export-ignore
/.gitignore        export-ignore
/.github/          export-ignore
/tests/            export-ignore
